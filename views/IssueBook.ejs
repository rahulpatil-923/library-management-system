<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Issue Book</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
  <style>
    .issue-form {
      background:#f6f8fa;
      border: 1.5px solid #2393cb;;
      border-radius: 12px;
      box-shadow: 0 0 15px rgba(0,0,0,0.08);
      max-width: 500px;
      width: 100%;
      margin: 30px 20px;
      padding: 3rem 2.5rem;
      padding-top: 40px;
   
    }
    .page-title {
      text-align: center;
      font-size: 1.5rem;
      margin-bottom: 1.2rem;
      font-weight: 700;
      color: #183153;
    }
    .admin-content {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background:  #2393cb;
    }
    .btn-success {
      font-weight: 600;
      font-size: 1.1rem;
      padding: 0.6rem 0;
    }
  </style>
</head>
<body>
    <div class="container-fluid">
      <div class="row">
        <div class="col-md-3 p-0"><%- include('sidebar') %></div>
        <div class="col-md-9 p-0 d-flex align-items-center justify-content-center" style="min-height:100vh;background:#2393cb;">
          <div class="issue-form">
            <div class="page-title">Issue Book</div>
            <form action="/issued-books/issue" method="POST">
              <div class="mb-3">
                <label for="book" class="form-label" style="font-weight:500;">Book</label>
                <select id="book" name="book_id" class="form-control" required>
                  <% if (typeof books !== 'undefined' && books.length > 0) { %>
                    <% books.forEach(function(book) { %>
                      <option value="<%= book.id %>"><%= book.title %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>
              <div class="mb-3">
                <label for="issued_by" class="form-label" style="font-weight:500;">User</label>
                <select id="issued_by" name="issued_by" class="form-control" required>
                  <% if (typeof users !== 'undefined' && users.length > 0) { %>
                    <% users.forEach(function(user) { %>
                      <option value="<%= user.id %>"><%= user.name %></option>
                    <% }) %>
                  <% } %>
                </select>
              </div>
              <div class="mb-3">
                <label for="issueDate" class="form-label" style="font-weight:500;">Issue Date</label>
                <input type="date" id="issueDate" name="issue_date" class="form-control" value="<%= currentDate %>" readonly />
              </div>
              <div class="mb-3">
                <label for="returnDate" class="form-label" style="font-weight:500;">Return Date (within 7 days)</label>
                <input type="date" id="returnDate" name="return_date" class="form-control" required />
              </div>
              <button type="submit" class="btn btn-success w-100">Issue</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
