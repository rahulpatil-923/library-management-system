<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Issue Book</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
      padding: 0;
      background-color: #f2f2f2;
    }

    .admin-content {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 40px;
    }

    .issue-form {
      background: #fff;
      padding: 2rem 2.5rem;
      border-radius: 10px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
      width: 100%;
      max-width: 550px;
    }

    .page-title {
      text-align: center;
      font-size: 28px;
      margin-bottom: 1.5rem;
      font-weight: bold;
      color: #333;
    }

    .form-group {
      margin-bottom: 1.3rem;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #444;
    }

    .form-group input,
    .form-group select {
      width: 100%;
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 16px;
    }

    .btn-submit {
      display: block;
      width: 100%;
      background-color: #007bff;
      color: white;
      padding: 12px;
      border: none;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      border-radius: 6px;
      transition: background-color 0.3s ease;
    }

    .btn-submit:hover {
      background-color: #0056b3;
    }
  </style>
</head>
<body>
 <%- include('../partials/layout', { title: "Issue Book" }) %>
<%- include('../partials/sidebar.ejs') %>
  <div class="admin-content">
    <form action="/issues" method="POST" class="issue-form">
      <h1 class="page-title">📕 Issue Book</h1>

      <div class="form-group">
        <label for="book_id">Book</label>
        <select name="book_id" required>
          <option value="">-- Select Book --</option>
          <% books.forEach(book => { %>
            <option value="<%= book.id %>"><%= book.title %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label for="student_name">Student Name</label>
        <input type="text" name="student_name" required />
      </div>

      <div class="form-group">
        <label for="student_email">Student Email</label>
        <input type="email" name="student_email" required />
      </div>

      <div class="form-group">
        <label for="issue_date">Issue Date</label>
        <input type="date" name="issue_date" value="<%= currentDate %>" required />
      </div>

      <div class="form-group">
        <label for="return_date">Return Date</label>
        <input type="date" name="return_date" />
      </div>

      <button type="submit" class="btn-submit">Issue Book</button>
    </form>
  </div>



<div class="admin-content">
  <h1>📕 Issue Book</h1>
  <form method="POST" action="/admin/issues">
    <!-- your form fields here -->
  </form>
</div>



</body>
</html>
