
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Add User</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="/style.css" />
    <style>
      /* Modern Attractive Add User Form Styles */
      .user-card {
        background: linear-gradient(120deg, #fafdff 60%, #eaf6fb 100%);
        border-radius: 18px;
        box-shadow: 0 8px 32px rgba(35,147,203,0.13), 0 1.5px 0 #2393cb;
        border: 2px solid #2393cb;
        padding: 28px 18px 22px 18px;
        margin: 48px 0 24px 0;
        max-width: 600px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 420px;
        animation: fadeInCard 0.7s cubic-bezier(.4,1.4,.6,1) 1;
        transition: box-shadow 0.2s, border 0.2s;
      }
      .user-card:hover {
        box-shadow: 0 12px 48px rgba(35,147,203,0.18), 0 2px 0 #2393cb;
        border-color: #183153;
      }
      .lms-form {
        width: 100%;
        max-width: 700px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .lms-form label {
        color: #1e6fa7;
        font-weight: 700;
        margin-bottom: 5px;
        font-size: 1rem;
        letter-spacing: 0.2px;
      }
      .lms-form input, .lms-form select {
        border: 1.2px solid #2393cb;
        border-radius: 7px;
        padding: 9px 10px;
        font-size: 1rem;
        background: #f8fafd;
        margin-bottom: 5px;
        outline: none;
        transition: border 0.2s, box-shadow 0.2s;
        box-shadow: 0 1px 0 #eaf6fb;
      }
      .lms-form input:focus, .lms-form select:focus {
        border: 2px solid #183153;
        box-shadow: 0 0 0 1.5px #b2d6ee;
      }
      .btn.lms-btn {
        background: linear-gradient(90deg, #2393cb 60%, #1e6fa7 100%);
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: 10px 0;
        font-size: 1.08rem;
        font-weight: 700;
        transition: background 0.2s, box-shadow 0.2s, transform 0.1s;
        box-shadow: 0 2px 8px rgba(35,147,203,0.13);
        min-width: 110px;
        margin-top: 10px;
        letter-spacing: 0.2px;
      }
      .btn.lms-btn:hover {
        background: linear-gradient(90deg, #183153 60%, #2393cb 100%);
        color: #fff;
        transform: translateY(-1px) scale(1.02);
        box-shadow: 0 3px 12px rgba(35,147,203,0.15);
      }
      @media (max-width: 900px) {
        .user-card {
          margin: 32px auto 0 auto;
          max-width: 98vw;
          padding: 16px 4px;
        }
        .lms-form {
          max-width: 98vw;
        }
      }
      @media (max-width: 700px) {
        .user-card {
          padding: 16px 4px;
          max-width: 98vw;
        }
        .user-card .lms-form {
          padding: 12px 2px 12px 2px;
        }
      }
    </style>
  </head>
  <body>
    <%- include ('sidebar')%>
    <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f8f8f9;">
      <div class="user-card user-card-lg">
        <h1 class="lms-title">Create New User</h1>
        <p class="lms-subtitle">Fill in the details below to add a new user to the system.</p>
        <% if (typeof msg !== 'undefined' && msg) { %>
          <div class="alert alert-info" id="msgAlert"><%= msg %></div>
        <% } %>
        <form class="lms-form" action="/user/register" method="POST">
          <label for="name">Name</label>
          <input type="text" name="name" id="name" required placeholder="Enter Name" />

          <label for="email">Email</label>
          <input type="email" name="email" id="email" required placeholder="Enter Email" />

          <label for="password">Password</label>
          <input type="password" name="password" id="password" required placeholder="Enter Password" />

          <label for="role">Role</label>
          <select name="role" id="role" required>
            <option value="" disabled selected>Select role</option>
            <option value="admin">Admin</option>
            <option value="librarian">Librarian</option>
            <option value="user">User</option>
          </select>

          <button type="submit" class="btn lms-btn">Add User</button>
        </form>
      </div>
    </div>
    <script>
      // Hide the message after 3 seconds
      window.onload = function () {
        const msgAlert = document.getElementById("msgAlert");
        if (msgAlert) {
          setTimeout(() => {
            msgAlert.style.display = "none";
          }, 2000);
        }
      };
    </script>
  </body>
</html>
