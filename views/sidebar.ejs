<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
 

  <div class="sidebar">
  <h4>Admin Dashboard</h4>

  <!-- User Section -->
  <div class="menu-section" id="userSection">
    <h5 onclick="toggleMenu('userMenu')">👤 User</h5>
    <ul id="userMenu" style="display: none;">
      <li><a href="/user/register">Add User</a></li>
      <li><a href="/user/view">View Users</a></li>
    </ul>
  </div>

  <!-- Category Section -->
  <div class="menu-section" id="categorySection">
    <h5 onclick="toggleMenu('categoryMenu')">📚 Category</h5>
    <ul id="categoryMenu" style="display: none;">
      <li><a href="/categories/add">Add Category</a></li>
      <li><a href="/categories/view">View Categories</a></li>
    </ul>
  </div>

  <!-- Book Section -->
  <div class="menu-section" id="bookSection">
    <h5 onclick="toggleMenu('bookMenu')">📖 Book</h5>
    <ul id="bookMenu" style="display: none;">
      <li><a href="/books/add">Add Book</a></li>
      <li><a href="/books/view">View Books</a></li>
    </ul>
  </div>

  <!-- Issue/Issued/Returned Books as separate sections -->
  <div class="menu-section" style="display:flex; align-items:center; gap:8px; margin-top:18px; cursor:pointer;" onclick="window.location.href='/issued-books/issue'">
    <span style="font-size:1.2em; color:#e74c3c;">📕</span>
    <span style="color:#fff;">Issue Book</span>
  </div>
  <div class="menu-section" style="display:flex; align-items:center; gap:8px; margin-top:10px; cursor:pointer;" onclick="window.location.href='/issued-books/view'">
    <span style="font-size:1.2em; color:#bc6c25;">📦</span>
    <span style="color:#fff;">Issued Books</span>
  </div>
  <div class="menu-section" style="display:flex; align-items:center; gap:8px; margin-top:10px; cursor:pointer;" onclick="window.location.href='/returned-books/view'">
    <span style="font-size:1.2em; color:#1976d2;">📘</span>
    <span style="color:#fff;">Returned Books</span>
  </div>

  <!-- Logout -->
  <div class="logout-section" style="position: absolute; bottom: 30px; width: 100%; text-align: left; padding-left: 30px;">
    <button onclick="window.location.href='/login'" class="btn btn-danger w-75" style="display:flex;align-items:center;gap:10px;justify-content:flex-start;">
      <span style="font-size:1.3em; color:#bc6c25;">🧱</span>
      <span style="font-weight:bold;">Logout</span>
    </button>
  </div>
</div>

<script>
  function toggleMenu(id) {
    const menu = document.getElementById(id);
    // Only one menu open at a time
    const allMenus = ['userMenu', 'categoryMenu', 'bookMenu'];
    allMenus.forEach(function(menuId) {
      if(menuId !== id) {
        document.getElementById(menuId).style.display = 'none';
      }
    });
    menu.style.display = menu.style.display === "none" ? "block" : "none";
  }
  // By default, all menus are hidden
  document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('userMenu').style.display = 'none';
    document.getElementById('categoryMenu').style.display = 'none';
    document.getElementById('bookMenu').style.display = 'none';
  });
</script>

</body>
</html>