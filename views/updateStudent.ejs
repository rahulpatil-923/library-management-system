<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Update User</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body style="background:#ffffff; min-height:100vh;">
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-3 p-0" style="background: linear-gradient(135deg, #2393cb 0%, #183153 100%); min-height:100vh;">
        <%- include('sidebar') %>
      </div>
      <div class="col-md-9" style="min-height:100vh; display: flex; align-items: flex-start; justify-content: flex-start;">
        <div class="user-card" style="max-width:600px; min-width:420px; margin-top:40px; margin-left:0; margin-right:auto;">
          <h2>Update User</h2>
          <% if (typeof msg !== 'undefined' && msg) { %>
            <div class="alert alert-success text-center" id="msgAlert"><%= msg %></div>
          <% } %>
          <form action="/user/update/<%= user.id %>" method="POST">
            <div class="mb-3">
              <label for="name" class="form-label">Name:</label>
              <input type="text" class="form-control" id="name" name="name" placeholder="Enter Name" value="<%= user.name %>" required>
            </div>
            <div class="mb-3">
              <label for="email" class="form-label">Email:</label>
              <input type="email" class="form-control" id="email" name="email" placeholder="Enter Email" value="<%= user.email %>" required>
            </div>
            <div class="mb-3">
              <label for="password" class="form-label">Password:</label>
              <input type="password" class="form-control" id="password" name="password" placeholder="Enter Password" value="<%= user.password %>" required>
            </div>
            <div class="mb-3">
              <label for="role" class="form-label">Role:</label>
              <select class="form-select" id="role" name="role" required>
                <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                <option value="librarian" <%= user.role === 'librarian' ? 'selected' : '' %>>Librarian</option>
                <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary w-100">Update User</button>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script>
    window.onload = function() {
      const msgAlert = document.getElementById('msgAlert');
      if (msgAlert) {
        setTimeout(() => {
          msgAlert.style.display = 'none';
        }, 3000);
      }
    };
  </script>
</body>
</html>
