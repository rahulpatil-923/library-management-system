<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Issued/Returned Books</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <!-- Custom External CSS -->
  <link rel="stylesheet" href="/style.css"/>
  <style>

      /* Sidebar should already be included */

.main-content {
  margin-left: 400px; /* to align beside sidebar */
  padding: 2rem;
}

.issued-return-page {
  background:#2393cb;
  border-radius: 12px;
  padding: 2rem;
  box-shadow: 0 0 18px rgba(0, 0, 0, 0.1);
  max-width: 1000px;
  margin: 2rem -10x;
}

.issued-return-page h2 {
  color: #183153;
  text-align: center;
  font-weight: bold;
}

.filters select,
.filters input {
  height: 38px;
  font-size: 15px;
  padding: 6px 10px;
  border-radius: 6px;
  border: 1px solid #ccc;
  width: 200px;
}

.badge {
  padding: 6px 12px;
  border-radius: 12px;
  font-size: 0.9rem;
}

.bg-success {
  background-color: #28a745 !important;
  color: white;
}

.bg-danger {
  background-color: #dc3545 !important;
  color: white;
}

.bg-warning {
  background-color: #ffc107 !important;
  color: #212529;
}

.btn-sm {
  padding: 6px 12px;
  font-size: 14px;
  border-radius: 5px;
}


  </style>
</head>
<body>

  <!-- Include sidebar from separate EJS file -->
  <%- include('sidebar') %>

  <!-- Main Content -->
  <div class="main-content issued-return-page">
    <h2>Issued / Returned Books</h2>

    <div class="filters d-flex gap-2 mb-3 justify-content-center flex-wrap">
      <select class="form-select w-auto">
        <option>All</option>
      </select>
      <input type="text" class="form-control" placeholder="Search...">
    </div>

    <div class="table-responsive">
      <table class="table table-bordered text-center align-middle">
        <thead class="table-dark">
          <tr>
            <th>Book</th>
            <th>User</th>
            <th>Email</th>
            <th>Issue Date</th>
            <th>Return Date</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% issuedBooks.forEach(book => { %>
            <tr>
              <td><%= book.book_title %></td>
              <td><%= book.student_name %></td>
              <td><%= book.student_email %></td>
              <td><%= book.issue_date %></td>
              <td><%= book.return_date %></td>
              <td>
                <% if (book.return_status === 'Returned') { %>
                  <span class="badge bg-success">Returned</span>
                <% } else if (new Date(book.return_date) < new Date()) { %>
                  <form action="/issued-books/returned" method="POST" style="display:inline;">
                    <input type="hidden" name="issue_id" value="<%= book.id %>">
                    <button type="submit" class="btn btn-sm btn-primary me-1">Return</button>
                  </form>
                  <span class="badge bg-danger">Overdue</span>
                <% } else { %>
                  <form action="/issued-books/returned" method="POST" style="display:inline;">
                    <input type="hidden" name="issue_id" value="<%= book.id %>">
                    <button type="submit" class="btn btn-sm btn-primary me-1">Return</button>
                  </form>
                  <span class="badge bg-warning text-dark">Issued</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</body>
</html>
