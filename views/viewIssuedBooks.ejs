<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>View Issued Books</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-3 p-0"><%- include('sidebar') %></div>
      <div class="col-md-9">
        <h3 class="mt-4 mb-4" style="font-weight:700;color:#183153;">Issued/Returned Books</h3>
        <div class="d-flex mb-3 align-items-center">
          <select class="form-select me-2" style="width:120px;max-width:120px;">
            <option>All</option>
            <option>Issued</option>
            <option>Returned</option>
            <option>Overdue</option>
          </select>
          <input type="text" class="form-control" placeholder="Search..." style="max-width:300px;">
        </div>
        <div class="table-responsive">
          <table class="table table-bordered align-middle">
            <thead style="background:#f3f6fa;">
              <tr>
                <th>Book</th>
                <th>User</th>
                <th>Email</th>
                <th>Issue Date</th>
                <th>Return Date</th>  
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (issuedBooks && issuedBooks.length > 0) { %>
                <% const today = new Date(); %>
                <% issuedBooks.forEach(function(book) { %>
                  <% let status = book.status; %>
                  <% if (status !== 'returned' && new Date(book.return_date) < today) { status = 'overdue'; } %>
                  <tr>
                    <td><%= book.book_title || book.book_id %></td>
                    <td><%= book.student_name || '' %></td>
                    <td><%= book.student_email || '' %></td>
                    <td><%= book.issue_date ? book.issue_date.toISOString ? book.issue_date.toISOString().split('T')[0] : book.issue_date : '' %></td>
                    <td><%= book.return_date ? book.return_date.toISOString ? book.return_date.toISOString().split('T')[0] : book.return_date : '' %></td>
                    <td style="display:flex;gap:8px;align-items:center;justify-content:center;">
                      <% if(status === 'issued') { %>
                        <span class="badge rounded-pill" style="background:#ffe6a7;color:#7a5c00;font-size:1em;">Issued</span>
                      <% } else if(status === 'overdue') { %>
                        <span class="badge rounded-pill" style="background:#f8d7da;color:#842029;font-size:1em;">Overdue</span>
                      <% } else if(status === 'returned') { %>
                        <span class="badge rounded-pill" style="background:#d1e7dd;color:#0f5132;font-size:1em;">Returned</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="6" class="text-center">No issued books found.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
