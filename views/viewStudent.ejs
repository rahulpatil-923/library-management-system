<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>View all Students</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container-fluid">
      <div class="row">
        <div class="col-md-3 p-0"><%- include('sidebar') %></div>
        <div class="col-md-9">
          <h4 class="mb-4">View all Students</h4>
          <form class="d-flex search-box" method="get" action="/user/view">
            <input
              class="search-box"
              type="search"
              name="q"
              placeholder="Search by any keyword..."
              value="<%= typeof query !== 'undefined' ? query : '' %>"
            />
            <button class="btn btn-outline-primary" type="submit">
              Search
            </button>
          </form>

          <div class="table-container mt-4">
            <div class="table-responsive">
              <table class="student-table table table-striped">
                <thead>
                  <tr>
                    <th>sr. no.</th>
                    <th>Name</th>
                    <th>Email / Username</th>
                    <th>Role</th>
                    <th>Admission Date</th>
                    <th>Update</th>
                    <th>Delete</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (Array.isArray(students) && students.length > 0) { %>
                    <% students.forEach(function(student, idx) { %>
                      <tr>
                        <td><%= (typeof page !== 'undefined' && typeof limit !== 'undefined') ? ((page - 1) * limit + idx + 1) : (idx + 1) %></td>
                        <td><%= student.name %></td>
                        <td><%= student.email %></td>
                        <td><%= student.role %></td>
                        <td><%= student.created_at ? student.created_at.toISOString().slice(0,10) : '' %></td>
                        <td><a href="/user/update/<%= student.id %>" class="action-link">update</a></td>
                        <td><a href="/user/delete/<%= student.id %>" class="action-link" onclick="return confirm('Are you sure you want to delete this student?');">delete</a></td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr><td colspan="7">No students found.</td></tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <% if (typeof page !== 'undefined' && typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <nav aria-label="Page navigation">
              <ul class="pagination mt-4">
                <% if (page > 1) { %>
                  <li class="page-item">
                    <a class="page-link" href="?q=<%= query %>&page=<%= page - 1 %>">Previous</a>
                  </li>
                <% } else { %>
                  <li class="page-item disabled"><span class="page-link">Previous</span></li>
                <% } %>

                <% for (let i = 1; i <= totalPages; i++) { %>
                  <li class="page-item <%= i === page ? 'active' : '' %>">
                    <a class="page-link" href="?q=<%= query %>&page=<%= i %>"><%= i %></a>
                  </li>
                <% } %>

                <% if (page < totalPages) { %>
                  <li class="page-item">
                    <a class="page-link" href="?q=<%= query %>&page=<%= page + 1 %>">Next</a>
                  </li>
                <% } else { %>
                  <li class="page-item disabled"><span class="page-link">Next</span></li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        </div>
      </div>
    </div>
  </body>
</html>
