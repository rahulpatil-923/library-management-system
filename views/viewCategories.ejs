<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>View Categories</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/style.css" />
  <style>
    .content-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: 20px;
    }
    .search-form {
      max-width: 400px;
      margin-bottom: 2rem;
    }
    .table-container {
      background: #fff;
      padding: 1.5rem;
      border-radius: 8px;
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
      margin-bottom: 2rem;
    }
    .category-table {
      width: 100%;
      min-width: 600px;
      margin-bottom: 0;
    }
    .category-table th,
    .category-table td {
      padding: 12px 15px;
      text-align: center;
      border: 1px solid #dee2e6;
    }
    .category-table th {
      background: #212529;
      color: white;
      font-weight: 500;
      white-space: nowrap;
    }
    .category-table td {
      background: white;
    }
  </style>
</head>
<body>
  <div class="container-fluid">
    <div class="row">
      <div class="col-md-3 p-0"><%- include('sidebar') %></div>
      <div class="col-md-9">
        <div class="content-wrapper">
          <h4 class="mb-4">📂 View Categories</h4>

          <!-- Error Message -->
          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger text-center"><%= error %></div>
          <% } %>

          <!-- Search Form -->
          <form class="search-form d-flex" method="get" action="/categories/view">
            <input
              type="text"
              name="q"
              class="form-control me-2"
              placeholder="Search category..."
              value="<%= typeof query !== 'undefined' ? query : '' %>"
            />
            <button class="btn btn-outline-primary me-2" type="submit">Search</button>
            <a href="/categories/add" class="btn btn-success">+ Add New</a>
          </form>

          <!-- Table -->
          <div class="table-container">
            <div class="table-responsive">
              <table class="category-table">
                <thead>
                  <tr>
                    <th>Sr. No</th>
                    <th>Category Name</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (categories && categories.length > 0) { %>
                    <% categories.forEach(function(category, idx) { %>
                      <tr>
                        <td><%= idx + 1 %></td>
                        <td><%= category.name %></td>
                        <td>
                          <a href="/categories/edit/<%= category.id %>" class="btn btn-sm btn-warning">✏️ Edit</a>
                          <a href="/categories/delete/<%= category.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this category?')">🗑️ Delete</a>
                        </td>
                      </tr>
                    <% }) %>
                  <% } else { %>
                    <tr>
                      <td colspan="3" class="text-center">No categories found.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Pagination -->
          <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mt-4">
              <% if (prevPage) { %>
                <li class="page-item">
                  <a class="page-link" href="?q=<%= query %>&page=<%= prevPage %>">Previous</a>
                </li>
              <% } %>
              <li class="page-item">
                <a class="page-link" href="?q=<%= query %>&page=<%= nextPage %>">Next</a>
              </li>
            </ul>
          </nav>

        </div>
      </div>
    </div>
  </div>
</body>
</html>
